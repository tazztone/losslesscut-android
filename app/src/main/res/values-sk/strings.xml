    <string name="tooltip_strategy_scene">Rozpoznáva ostré prechody medzi zábermi kamery. Najvhodnejšie na rozdelenie filmov alebo záznamov z viacerých kamier na jednotlivé scény.</string>
    <string name="tooltip_strategy_black">Rozpoznáva úplne tmavé snímky. Je to užitočné pri vyhľadávaní a odstraňovaní prechodov do čiernej alebo prázdnych medzier.</string>
    <string name="tooltip_strategy_freeze">Detekuje zamrznuté úseky videa, v ktorých sú po sebe idúce snímky identické. Je to užitočné na odfiltrovanie statických prestávok alebo oneskorenia obrazu.</string>
    <string name="tooltip_strategy_blur">Rozpoznáva rozmazané alebo nezaostrené zábery a automaticky odfiltruje nepodarené zábery.</string>
    <string name="tooltip_sample_interval">Frekvencia analýzy. Nižšie intervaly (100–200 ms) zvyšujú presnosť, ale analýza prebieha pomalšie; vyššie intervaly (500 ms a viac) sú rýchlejšie, ale môžu prehliadnuť rýchle strihy.</string>
    <string name="tooltip_sensitivity">Detekčný prah. Nižšie hodnoty zachytávajú jemné zmeny; vyššie hodnoty reagujú len na výrazné, zreteľné zmeny.</string>
    <string name="tooltip_min_segment">Minimálna dĺžka uchovávaných segmentov. Zvýšením tejto hodnoty zabránite vzniku krátkych, nesúvislých fragmentov na časovej osi.</string>
    <string name="tooltip_noise_threshold">Hladina zvuku, pod ktorou sa zvuk považuje za ticho. Túto hodnotu zvýšte, ak vám hluk v pozadí (hučanie, klimatizácia, dýchanie) bráni v strihaní.</string>
    <string name="tooltip_min_segment_audio">Minimálna dĺžka zachovaných zvukových segmentov. Nižšie hodnoty zachovávajú krátke slová; vyššie hodnoty odfiltrujú krátke zvuky, ako je kašeľ alebo nárazy do mikrofónu.</string>
    <string name="tooltip_min_silence_duration">Minimálna dĺžka ticha potrebná na spustenie strihu. Nižšie hodnoty spôsobujú rýchle tempo; vyššie hodnoty zachovávajú prirodzené pauzy.</string>
    <string name="tooltip_padding_prefix">Výplň pridaná pred začiatkom zachovaného segmentu. Zabraňuje tomu, aby sa začiatky slov javili ako odrezané.</string>
    <string name="tooltip_padding_postfix">Výplň pridaná po skončení zachovaného segmentu. Zabraňuje príliš náhlemu prerušeniu zvuku.</string>
    <string name="tooltip_detect">Spustí analýzu snímok. Pred použitím môžete na časovej osi upraviť a skontrolovať rozsahy náhľadu.</string>
    <string name="tooltip_apply_smart_cut">Vykoná strihy. Odstráni červené segmenty a zlúči zelené segmenty na hlavnej časovej osi.</string>
    <string name="tooltip_silence_tab">Zisťuje a odstraňuje tiché pauzy. Ideálne pre podcasty, prednášky alebo videá s hovoriacou osobou.</string>
    <string name="tooltip_visual_tab">Beta: vyhľadáva prechody medzi scénami, čierne snímky alebo zamrznuté video. Výsledky môže byť potrebné skontrolovať.</string>
