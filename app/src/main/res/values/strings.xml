    <!-- Tooltips -->
    <string name="tooltip_strategy_scene">Detects hard cuts between camera shots. Best for splitting movies or multi-cam footage into individual scenes.</string>
    <string name="tooltip_strategy_black">Detects fully dark frames. Useful for finding and removing "fade to black" transitions or empty gaps.</string>
    <string name="tooltip_strategy_freeze">Detects frozen video segments where consecutive frames are identical. Useful for filtering static pauses or screen lag.</string>
    <string name="tooltip_strategy_blur">Detects blurry or out-of-focus footage to automatically filter out bad takes.</string>
    <string name="tooltip_sample_interval">Analysis frequency. Lower intervals (100–200ms) increase precision but analyze slower; higher intervals (500ms+) are faster but may miss quick cuts.</string>
    <string name="tooltip_sensitivity">Detection threshold. Lower values detect subtle changes; higher values trigger only on major, obvious shifts.</string>
    <string name="tooltip_min_segment">Minimum duration for kept segments. Increase this value to prevent short, choppy fragments on the timeline.</string>
    <string name="tooltip_noise_threshold" formatted="false">Audio level below which sound is considered silence. Increase if background noise (hum, AC, breathing) is preventing cuts.</string>
    <string name="tooltip_min_segment_audio">Minimum duration for kept audio segments. Lower values keep short words; higher values filter brief noises like coughs or mic bumps.</string>
    <string name="tooltip_min_silence_duration">Minimum silence duration required to trigger a cut. Lower values create tight pacing; higher values preserve natural pauses.</string>
    <string name="tooltip_padding_prefix">Padding added before a kept segment starts. Prevents word beginnings from feeling cut off.</string>
    <string name="tooltip_padding_postfix">Padding added after a kept segment ends. Prevents audio from cutting off too abruptly.</string>
    <string name="tooltip_detect">Starts frame analysis. You can adjust and review the preview ranges on the timeline before applying.</string>
    <string name="tooltip_apply_smart_cut">Applies the cuts. Discards red segments and merges green segments on the main timeline.</string>
    <string name="tooltip_silence_tab">Detects and removes silent pauses. Ideal for podcasts, lectures, or talking-head videos.</string>
    <string name="tooltip_visual_tab">Scans for scene transitions, black frames, or frozen video. Ideal for screen recordings or B-roll.</string>
