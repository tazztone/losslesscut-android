    <!-- Tooltips -->
    <string name="tooltip_strategy_scene">Erkennt harte Schnitte zwischen Kameraeinstellungen. Ideal zum Aufteilen von Filmen oder Mehrkameraaufnahmen.</string>
    <string name="tooltip_strategy_black">Erkennt vollständig dunkle Frames. Nützlich zum Finden und Entfernen von Schwarzblenden oder leeren Abschnitten.</string>
    <string name="tooltip_strategy_freeze">Erkennt eingefrorene Videobereiche mit identischen aufeinanderfolgenden Frames.</string>
    <string name="tooltip_strategy_blur">Erkennt unscharfe oder defokussierte Aufnahmen, um schlechte Takes zu filtern.</string>
    <string name="tooltip_sample_interval">Analysefrequenz. Kleinere Intervalle erhöhen die Genauigkeit, analysieren aber langsamer.</string>
    <string name="tooltip_sensitivity">Erkennungsschwelle. Kleinere Werte erkennen subtile Änderungen, größere nur deutliche Verschiebungen.</string>
    <string name="tooltip_min_segment">Mindestdauer für behaltene Segmente. Höhere Werte verhindern kurze Fragmente.</string>
    <string name="tooltip_noise_threshold" formatted="false">Audiopegel, unter dem Ton als Stille gilt. Erhöhen, wenn Hintergrundgeräusche Schnitte verhindern.</string>
    <string name="tooltip_min_segment_audio">Mindestdauer für behaltene Audiosegmente.</string>
    <string name="tooltip_min_silence_duration">Mindestdauer der Stille für einen Schnitt.</string>
