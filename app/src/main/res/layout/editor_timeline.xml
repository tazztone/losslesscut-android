<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/seekerContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">

        <com.tazztone.losslesscut.customviews.CustomVideoSeeker
            android:id="@+id/customVideoSeeker"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <Button
            android:id="@+id/btnAudioTrackBadge"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_gravity="top|start"
            android:layout_marginTop="2dp"
            android:layout_marginStart="2dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="A1 ▾"
            android:textSize="10sp"
            android:visibility="gone"
            android:contentDescription="@string/select_audio_track"
            android:tooltipText="@string/select_audio_track"/>
    </FrameLayout>
</LinearLayout>
